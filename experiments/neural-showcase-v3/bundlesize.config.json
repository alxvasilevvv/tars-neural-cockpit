{
  "_meta": {
    "wave": 128,
    "rationale": "Bundle size gate to prevent W124-class perf regressions (tsparticles ~50KB sneaking in on Landing, RobotAvatar 547 LOC eager on Cockpit, etc.). Budgets reflect the realistic state at the time of Wave 128 — tighten over time, never loosen without a written justification in the PR.",
    "ratchet_policy": "Update budgets only via a PR that explains the regression cause AND links to a tracking issue for follow-up cleanup."
  },
  "budgets": [
    {
      "path": "dist/assets/index-*.js",
      "label": "main bundle (entry)",
      "max_gzip_kb": 80,
      "warn_gzip_kb": 70
    },
    {
      "path": "dist/assets/Landing-*.js",
      "label": "Landing route",
      "max_gzip_kb": 60,
      "warn_gzip_kb": 50
    },
    {
      "path": "dist/assets/Cockpit-*.js",
      "label": "Cockpit route",
      "max_gzip_kb": 80,
      "warn_gzip_kb": 70
    },
    {
      "path": "dist/assets/Workshop-*.js",
      "label": "Workshop route",
      "max_gzip_kb": 60,
      "warn_gzip_kb": 50
    },
    {
      "path": "dist/assets/Dashboard-*.js",
      "label": "Dashboard route",
      "max_gzip_kb": 60,
      "warn_gzip_kb": 50
    },
    {
      "path": "dist/assets/vendor-*.js",
      "label": "vendor chunk",
      "max_gzip_kb": 200,
      "warn_gzip_kb": 180
    },
    {
      "path": "dist/index.html",
      "label": "HTML shell",
      "max_gzip_kb": 8,
      "warn_gzip_kb": 6
    }
  ],
  "fail_threshold_growth_pct": 10,
  "comment_on_pr": true
}
