# Copy to `.env.development.local` or `.env.local` (gitignored via `*.local`).
# Host root only (no `/api` suffix) — client appends `/api/...` paths.
VITE_TARS_API=http://127.0.0.1:8765

# Production build (tracked): `experiments/neural-showcase-v3/.env.production`
# — `npm run build` bakes `VITE_TARS_API` from that file.

# GitHub Actions static hosting only (local dev normally uses "/"):
# VITE_BASE_PATH=/YOUR_REPO_NAME/
