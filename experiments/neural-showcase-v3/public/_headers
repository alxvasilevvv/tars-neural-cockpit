# Cloudflare Pages headers config — applies on every response.
# Format: https://developers.cloudflare.com/pages/configuration/headers/

# ----- Security headers (apply to everything) -----
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Tars-Subdomain: tars.meeet.world
  X-Tars-Contract: 1.0.0

# ----- Marketing HTML — short TTL with SWR -----
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/install
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/pitch
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/pricing
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/faq
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/compare
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/cockpit
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

# ----- Hashed bundle assets — immutable -----
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ----- Service worker — never cache (must update) -----
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# ----- Open Graph SVG previews — long cache -----
/og*.svg
  Cache-Control: public, max-age=604800
