# Cloudflare Pages headers config — applies on every response.
# Format: https://developers.cloudflare.com/pages/configuration/headers/

# ----- Security headers (apply to everything) -----
# Frame embedding: explicitly allow `https://meeet.world` to embed the
# cockpit in an iframe (TARS#8 task 3b). `X-Frame-Options` cannot list
# multiple origins, so we drop it and rely on CSP `frame-ancestors`,
# which is the W3C-recommended replacement and supported by every
# browser the cockpit targets. Adding a new parent later means
# extending this directive only.
/*
  Content-Security-Policy: frame-ancestors 'self' https://meeet.world
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Tars-Subdomain: tars.meeet.world
  X-Tars-Contract: 1.0.0

# ----- Marketing HTML — short TTL with SWR -----
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/install
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/pitch
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/pricing
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/faq
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/compare
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

/cockpit
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400

# ----- Hashed bundle assets — immutable -----
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ----- Service worker — never cache (must update) -----
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# ----- Open Graph SVG previews — long cache -----
/og*.svg
  Cache-Control: public, max-age=604800
