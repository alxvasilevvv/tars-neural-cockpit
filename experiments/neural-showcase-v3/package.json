{
  "name": "tars-neural-showcase-v3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TARS Neural Cockpit — React + Tailwind v4 + framer-motion. Built per ui-ux-pro-max-skill MASTER.md, ready for 21st.dev component drops.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "predev": "python3 ../../scripts/generate_public_changelog.py",
    "dev": "vite",
    "prebuild": "node scripts/check-route-imports.mjs && python3 ../../scripts/generate_public_changelog.py",
    "check:routes": "node scripts/check-route-imports.mjs",
    "build:cf": "vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:lighthouse": "npx --yes lighthouse https://tars.meeet.world --only-categories=performance,accessibility --chrome-flags=\"--headless=new\" --output=json --output-path=./lighthouse.json",
    "audit:axe": "npx --yes @axe-core/cli https://tars.meeet.world --exit",
    "changelog:check": "python3 ../../scripts/generate_public_changelog.py --check",
    "size": "node scripts/measure-bundle.mjs",
    "size:check": "npm run build && npm run size"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@splinetool/react-spline": "^4.1.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.460.0",
    "postprocessing": "^6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^2.5.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
