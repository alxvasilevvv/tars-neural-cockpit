# Copy to `.env` and fill in. Never commit `.env`.
# See `docs/SECOND_MACHINE_HANDOFF.md` for full setup.

# --- meeet.world ingest (backend → cloud event store)
# Leave MEEET_INGEST_URL unset for local-only (bridge no-ops; traces still generated).
MEEET_INGEST_URL=
MEEET_API_KEY=
MEEET_CONTRACT_VERSION=1.1.0
MEEET_SOURCE=tars
# Optional NDJSON audit on disk for replay: `python -m backend.core.meeet.replay_cli`
MEEET_LOCAL_LOG=

# --- Download / release URLs (marketing + desktop updater)
TARS_DOWNLOAD_BASE_URL=https://meeet.world/downloads/tars

# --- Optional diagnostics
# MEEET_REPLAY_INTERVAL_S=
