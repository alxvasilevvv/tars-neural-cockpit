# Copy to `.env` and fill in. Never commit `.env`.
# See `docs/SECOND_MACHINE_HANDOFF.md` for full setup.

# --- meeet.world ingest (backend → cloud event store)
# Leave MEEET_INGEST_URL unset for local-only (bridge no-ops; traces still generated).
# Prod (Supabase function tars-ingest on core project):
#   MEEET_INGEST_URL=https://zujrmifaabkletgnpoyw.supabase.co/functions/v1/tars-ingest
MEEET_INGEST_URL=
# Same value Supabase configures as API key / Bearer for tars-ingest (not committed).
MEEET_API_KEY=
# QA agent CI + local: optional override for ingest heartbeat probe (often same as MEEET_API_KEY).
# `make qa-agent` sources repo `.env` automatically; if this is unset, the agent still tries MEEET_API_KEY above.
TARS_INGEST_API_KEY=
MEEET_CONTRACT_VERSION=1.1.0
MEEET_SOURCE=tars
# Optional NDJSON audit on disk for replay: `python -m backend.core.meeet.replay_cli`
MEEET_LOCAL_LOG=

# --- meeet core ↔ TARS core-bridge (Lovable-deployed Edge Function)
# Used by `make smoke-core-bridge` / `make gate-control-tower` and the
# qa-agent acceptance gate. Same value lives in:
#   - meeet core Supabase project secrets (`zujrmifaabkletgnpoyw`)
#   - GitHub Actions repo secrets (for CI gates)
# See docs/SYNC.md §7 + docs/contracts/CORE_BRIDGE.md.
BRIDGE_SHARED_SECRET=

# --- meeet.world authoritative billing (optional; see docs/contracts/TARS_MEEET_BILLING.md)
# Interactive prod smoke + merge into .env: `make ops-billing-remote-wizard`
# After remote vars are set: `make smoke-billing-tars` (stdlib snapshot, no uvicorn)
# Dev API on :8765 with .env + probe: `make backend-tars-up`  →  stop: kill $(cat /tmp/tars-backend-8765.pid)
# API + cockpit UI: `make dev-tars-stack` (Ctrl+C stops Vite only; then kill pid file above)
# When set to `remote`, tier + cloud spend gate + GET /api/entitlements `live` block mirror meeet.world.
# TARS_PAYMENT_MODE upgrade mock path is bypassed for paid tiers — upgrade returns `redirect` to meeet.
# TARS_BILLING_SOURCE=remote
# MEEET_BILLING_BASE_URL=https://zujrmifaabkletgnpoyw.supabase.co/functions/v1/tars-billing
# (or proxied path https://meeet.world/api/tars-billing/v1 — must resolve to GET …/operator)
# MEEET_BILLING_API_KEY=
# Optional cap per mirrored usage.tokens POST (default 50); see TARS_MEEET_BILLING.md
# MEEET_BILLING_MAX_DELTA_USD=50
# Retries for POST /operator/usage on transient errors (default 3, max 8)
# MEEET_BILLING_USAGE_RETRIES=3
# Optional stable seat id for future multi-host accounting:
# TARS_OPERATOR_ID=

# --- Download / release URLs (marketing + desktop updater)
# Default points at the GitHub Releases CDN — that's where CI publishes
# tagged installers (`.dmg`, `.msi`, `.AppImage`, `.deb`) plus the
# Tauri updater manifest (`latest.json`).
# When meeet.world serves a 1st-party download mirror at
# https://meeet.world/downloads/tars (proxy → same GitHub artefacts),
# operators can swap to that URL without recompiling. As of 2026-05-05
# the meeet.world path is NOT yet hosted; keep the GitHub URL until
# the proxy ships.
TARS_DOWNLOAD_BASE_URL=https://github.com/alxvasilevvv/tars-neural-cockpit/releases/latest/download

# --- Optional diagnostics
# MEEET_REPLAY_INTERVAL_S=


# --- Apple Developer signing (optional, for macOS .app/.dmg distribution)
# Required for `scripts/SIGN-AND-NOTARIZE.command` and required by
# `scripts/RELEASE-v9.3.0-beta1.command` (and later release scripts).
# When these three are set, `scripts/REBUILD-TARS-APP.command` auto-signs
# + notarizes after every build. Without them, the build still succeeds
# but the bundle remains unsigned (dev-only — Gatekeeper will reject it
# on any other Mac).
#
# One-time setup (~15 min): see `docs/APPLE_SIGNING_SETUP.md`
# APPLE_TEAM_ID=XXXXX
# APPLE_DEVELOPER_ID_APPLICATION=Developer ID Application: Your Name (XXXXX)
# APPLE_NOTARY_PROFILE=tars-notary

# --- W274 — Premium TTS (ElevenLabs Multilingual v2)
# When set, TARS speaks with natural human-quality voices in 29
# languages (incl. Russian) instead of the robotic browser TTS.
# Sign up: https://elevenlabs.io/ — Starter $5/mo covers ~30K chars
# (≈10 minutes of speech per day). Without the key, the cockpit
# falls back to window.speechSynthesis with zero degradation in UX.
# ELEVENLABS_API_KEY=

# Optional — Creator plan ($11/mo) unlocks instant voice cloning.
# Set to "1" only after upgrading + verifying the plan in the EL dashboard.
# ELEVENLABS_CREATOR_PLAN=

# --- W274 — Conversation memory storage path (default: ~/.tars/conversations.sqlite)
# TARS_CONVERSATIONS_DB_PATH=
