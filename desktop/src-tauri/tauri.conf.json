{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "TARS",
  "version": "9.1.0",
  "identifier": "world.meeet.tars",
  "build": {
    "frontendDist": "./web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run serve:web",
    "beforeBuildCommand": "pnpm run cockpit:package"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TARS",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 https://meeet.world https://api.meeet.world; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "externalBin": [
      "binaries/tars-sidecar"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first neural cockpit",
    "longDescription": "TARS \u2014 local-first neural cockpit released under meeet.world. Threads, voice, automations, files, full observability.",
    "publisher": "meeet.world",
    "copyright": "\u00a9 meeet.world",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null,
      "exceptionDomain": null,
      "providerShortName": "meeet"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/alxvasilevvv/tars-neural-cockpit/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMjlGM0E2NzNBQTY3NTUKUldSVlo2cHpwdk1wRzg4ME8xVm14bHVoL0xlc0NzSFIyd1d4a2pBMTI5akRDODNDZUpQTzVHVWkK"
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "tars"
        ]
      }
    }
  }
}
