# Шаблон для оператора. Скопировать в cf-operator.env и вставить значения:
#   cp cf-operator.env.example cf-operator.env
#
# Account ID — Cloudflare → Workers & Pages → Account ID (справа сверху).
# API token — My Profile → API Tokens → Custom: Account → Cloudflare Pages → Edit;
#   Include → тот же аккаунт, что и проект tars-meeet.
#
# Затем:  make ops-cf-pages-token
# Файл cf-operator.env в репозиторий не попадает.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
