# ── Один раз на своём Mac ─────────────────────────────────────────
# 1) Скопируй этот файл (имя важно):
#       cp cf-operator.env.example cf-operator.env
# 2) Открой cf-operator.env и вставь значения справа от = (без пробелов).
# 3) В терминале из корня репозитория:
#       make ops-cf-pages-token
#
# Файл cf-operator.env в Git не попадает (см. .gitignore).

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
