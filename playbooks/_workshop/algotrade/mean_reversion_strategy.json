{
  "_meta": {
    "vertical": "algotrade",
    "workshop_phase": "design",
    "teaches": "How to compose a mean-reversion Strategy IR (Bollinger lower-band + RSI oversold), backtest it on BTC/USDT 1h candles, then promote to a 7-day paper session under a strict risk policy.",
    "estimated_runtime_seconds": 45,
    "owner": "claude+cursor"
  },
  "id": "_workshop.algotrade.mean_reversion_strategy",
  "name": "Mean reversion (Bollinger + RSI)",
  "description": "Workshop walk-through: register the bollinger_reversion recipe, run a Binance BTCUSDT 1h backtest, and start a paper session under a hardened risk policy (kill_switch, $25k position cap, no shorts). Use this as the first design-phase playbook in Day 1.",
  "tags": ["algotrade", "workshop", "mean-reversion", "btc", "design"],
  "pack": "algotrade",
  "on_block": "stop",
  "steps": [
    {
      "id": "register",
      "action": "algotrade.register_strategy",
      "args": {
        "recipe": "bollinger_reversion",
        "author": "${env.USER}",
        "metadata": {
          "source": "workshop:mean_reversion",
          "vertical": "algotrade"
        }
      },
      "store_as": "strategy"
    },
    {
      "id": "backtest",
      "action": "algotrade.backtest",
      "args": {
        "fingerprint": "${steps.strategy.fingerprint}",
        "binance": { "symbol": "BTCUSDT", "interval": "1h", "limit": 500 },
        "equity_down_sample": 200
      },
      "store_as": "report",
      "on_error": "stop"
    },
    {
      "id": "paper",
      "action": "algotrade.start_paper_session",
      "args": {
        "fingerprint": "${steps.strategy.fingerprint}",
        "instrument": "BINANCE:BTCUSDT",
        "sandbox_id": "${env.WORKSHOP_SANDBOX_ID}",
        "notes": "Day 1: mean reversion paper run.",
        "config": {
          "commission_bps": 1.0,
          "slippage_bps": 2.0,
          "starting_cash": 100000.0
        },
        "policy": {
          "kill_switch": false,
          "max_order_qty": 0.5,
          "max_position_notional": 25000.0,
          "max_open_positions": 1,
          "allow_short": false,
          "allowed_instruments": ["BINANCE:BTCUSDT", "BINANCE:ETHUSDT"],
          "notes": "Workshop strict v1 — Day 1 mean reversion."
        }
      },
      "store_as": "session",
      "on_error": "stop"
    }
  ]
}
