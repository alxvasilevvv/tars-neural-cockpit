# scripts/ONPREM-DEPLOY/.env.onprem.example — W263
#
# Template for on-prem deployment env. Copy to .env.onprem and edit;
# install.sh handles the <generate> tokens automatically.
#
#   cp scripts/ONPREM-DEPLOY/.env.onprem.example scripts/ONPREM-DEPLOY/.env.onprem
#
# Never commit .env.onprem.

# ────────────────────────────────────────────────────────────────────
# Deployment mode — flips backend off the meeet.world auth/billing path
# ────────────────────────────────────────────────────────────────────

# `onprem` is enforced by docker-compose.yml; left here for clarity if
# someone runs the backend image standalone.
MEEET_MODE=onprem

# Toggles backend/core/onprem/local_auth.py. When 1, the auth_meeet
# router short-circuits all magic-link / OAuth handshakes and serves a
# local JWT signed by TARS_AUTH_LOCAL_SIGNING_KEY.
TARS_AUTH_LOCAL=1

# 32-byte hex; install.sh mints this. Rotate at will — invalidates all
# active sessions.
TARS_AUTH_LOCAL_SIGNING_KEY=<generate>

# ────────────────────────────────────────────────────────────────────
# Postgres
# ────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=<generate>

# Where the backend connects. The compose service name `postgres` works
# inside the compose net; change only if running Postgres externally.
TARS_DB_DRIVER=postgresql+psycopg
# Auto-assembled from POSTGRES_PASSWORD in docker-compose.yml; uncomment
# to override.
# TARS_DB_URL=postgresql+psycopg://tars:CHANGEME@postgres:5432/tars

# ────────────────────────────────────────────────────────────────────
# Identity provider (SAML/OIDC) — optional
# ────────────────────────────────────────────────────────────────────
# If unset, on-prem uses TARS-local accounts (ADMIN_BOOTSTRAP_TOKEN
# below seeds the first admin). When set, every login redirects to the
# IdP and the returned token is exchanged for a local TARS session.
#
# Tested with: Okta, Azure AD, Google Workspace, Keycloak, Authentik.

MEEET_ONPREM_IDP_URL=
# OIDC discovery URL — typically <issuer>/.well-known/openid-configuration
# e.g. https://your-tenant.okta.com/.well-known/openid-configuration
MEEET_ONPREM_OIDC_DISCOVERY=
MEEET_ONPREM_OIDC_CLIENT_ID=
MEEET_ONPREM_OIDC_CLIENT_SECRET=
# SAML alternative — point at the IdP metadata XML.
MEEET_ONPREM_SAML_METADATA_URL=
# Group claim that maps to TARS admin role.
MEEET_ONPREM_ADMIN_GROUP=tars-admins

# ────────────────────────────────────────────────────────────────────
# First-run admin bootstrap (one-shot)
# ────────────────────────────────────────────────────────────────────

# Token used exactly once to bootstrap the first admin account. Rotate
# (or unset) after the first login.
ADMIN_BOOTSTRAP_TOKEN=<generate>
# Email shown in the admin profile after bootstrap.
ADMIN_BOOTSTRAP_EMAIL=admin@example.local

# ────────────────────────────────────────────────────────────────────
# Hardening / operator confirm
# ────────────────────────────────────────────────────────────────────

TARS_REQUIRE_OPERATOR_CONFIRM=1
TARS_CONFIRM_KEY=<generate>
TARS_VAULT_KEY=<generate>
TARS_HIDE_TRACEBACKS=1
TARS_AUDIT_RETENTION_DAYS=365

# Bridge secret for the (optional) outbound webhook to meeet.world. Left
# blank by default — air-gapped deployments never need it.
BRIDGE_SHARED_SECRET=<generate>

# ────────────────────────────────────────────────────────────────────
# Networking
# ────────────────────────────────────────────────────────────────────

# nginx listen ports (host side). Default 80/443. Bump if those are
# already taken on the host.
TARS_HTTP_PORT=80
TARS_HTTPS_PORT=443

# Uvicorn workers per backend container. Rule of thumb: (2*CPU)+1, cap 8.
UVICORN_WORKERS=2
UVICORN_LOG_LEVEL=info

# ────────────────────────────────────────────────────────────────────
# Observability
# ────────────────────────────────────────────────────────────────────

# Prometheus scrape — endpoint at /metrics on the backend.
PROMETHEUS_ENABLED=1
PROMETHEUS_NAMESPACE=tars

# OTel exporter — point at a collector if you run one. Otherwise leave
# blank for spans-to-stdout fallback.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tars-onprem
OTEL_SERVICE_VERSION=10.0.0-rc.1

# ────────────────────────────────────────────────────────────────────
# Mock meeet (optional — only when started with --profile mock-meeet)
# ────────────────────────────────────────────────────────────────────

# Set 1 to make backend hit the in-cluster mock instead of the real
# meeet.world URLs (which on-prem leaves blank by default anyway).
ONPREM_MOCK_MEEET=0

# ────────────────────────────────────────────────────────────────────
# LLM providers (operator chooses — none required if running local only)
# ────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local model fallback — pointed at ollama, llama.cpp, or vLLM.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=

# ────────────────────────────────────────────────────────────────────
# On-chain anchor (optional, off by default for air-gapped sites)
# ────────────────────────────────────────────────────────────────────
# When set, receipts are still hash-chained locally, and a daily Merkle
# root posts to Solana as a memo. Leave blank to skip.
ANCHOR_SOLANA_RPC_URL=
ANCHOR_SOLANA_KEYPAIR_PATH=
