# scripts/ONPREM-DEPLOY/Dockerfile.frontend — W263
#
# Two-stage build:
#   1. `node` stage — builds the React cockpit (experiments/neural-showcase-v3)
#      against /api → http://backend:8765 in compose net.
#   2. `nginx` stage — serves /usr/share/nginx/html + reverse-proxies
#      /api/* and /ws/* to the backend service.
#
# Build:
#   docker build -f scripts/ONPREM-DEPLOY/Dockerfile.frontend \
#       -t tars/frontend:10.0.0-rc.1 .

# ── Stage 1: build the cockpit ──────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /src

# pnpm — matches desktop/ workflow.
RUN npm install -g pnpm@9

# Cockpit lives at experiments/neural-showcase-v3 (same source as the
# Tauri .app webview). Copy package files first for layer caching.
COPY experiments/neural-showcase-v3/package.json \
     experiments/neural-showcase-v3/pnpm-lock.yaml* \
     /src/

RUN pnpm install --frozen-lockfile || pnpm install

COPY experiments/neural-showcase-v3 /src/

# On-prem build: backend lives at /api on the same origin.
ENV VITE_API_BASE_URL=/api
ENV VITE_WS_BASE_URL=/ws
ENV VITE_ONPREM=1

RUN pnpm build

# ── Stage 2: nginx serves the built bundle + proxies API ────────────
FROM nginx:1.27-alpine

# Generated bundle.
COPY --from=build /src/dist /usr/share/nginx/html

# Reverse-proxy config — drops /api/* to backend:8765 and /ws/* to the
# same upstream with WS upgrade headers.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY <<'NGINX_EOF' /etc/nginx/conf.d/tars.conf
upstream tars_backend {
    server backend:8765;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Liveness probe for compose healthcheck.
    location = /health {
        proxy_pass http://tars_backend/health;
        access_log off;
    }

    # API surface — every /api/* path goes to FastAPI.
    location /api/ {
        proxy_pass http://tars_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;  # SSE needs unbuffered.
    }

    # WebSocket — W248 event bus (/ws/events) + cowork stream.
    location /ws/ {
        proxy_pass http://tars_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Prometheus scrape endpoint (auth + IP-allowlist applied at LB).
    location = /metrics {
        proxy_pass http://tars_backend/metrics;
        access_log off;
    }

    # Cockpit SPA — fall through to index.html for client-side routing.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        # Long-cache hashed assets, short-cache HTML.
        location ~* \.(?:js|css|woff2|svg|png|jpg|jpeg|gif|webp)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }
}
NGINX_EOF

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1/health || exit 1

EXPOSE 80 443
