#!/usr/bin/env bash
# tars-doctor — unified TARS health check (Wave 154).
#
# Runs every local subsystem check (daemon heartbeat, MCP registry,
# Clone sync, scheduler, webhooks, cowork, receipts, vault) and
# prints a one-screen status table.
#
# Usage:
#   tars-doctor              # human-readable table
#   tars-doctor --json       # machine-readable JSON
#   tars-doctor --quiet      # only show problems (status != ok)
#   tars-doctor --check mcp  # run a single check
#   tars-doctor --list       # list available checks
#
# Exit codes:
#   0  all ok / skip
#   1  at least one warn
#   2  at least one fail

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${TARS_PYTHON:-python3}"

cd "$REPO_DIR"
export PYTHONPATH="${PYTHONPATH:-}:$REPO_DIR"

exec "$PYTHON" -m backend.core.doctor "$@"
